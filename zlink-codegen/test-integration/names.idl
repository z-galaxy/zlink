# Names that can't be taken over into Rust code as they are.
interface org.example.names

# A node, with fields that are named after keywords.
type Node (
    self: string,
    crate: int,
    super: ?string,
    type: string,
    try: bool,
    gen: ?string
)

error HTTPError(self: string)

# A method with an acronym in its name, and parameters and an output named after keywords.
method GetUUID(self: string, crate: int) -> (super: string)

# A method that is named after a keyword.
method Self() -> ()
